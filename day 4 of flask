// python flask file
from flask import Flask, redirect , url_for , render_template
app = Flask(__name__)

@app.route("/<name>")
def home(name):
    return render_template("index.html",content = name)

if __name__ == '__main__':
    app.run()
/// html file 
<html>
    <head>
        <title> home page</title>
    </head>
    <body>
        <h1> home </h1>
        <p> {{ content }}</p>
        <p> dveloper </p>
        {% for x in range(10) %}
            <p> x </p>
        {% endfor %}
    </body>
</html>
