from flask import Flask, redirect , url_for
app = Flask(__name__)
@app.route("/")
def home():
    return "Hello this is home page <h1> Hello </h1> "
@app.route("/<name>") 
def name(name):
    return f"hello {name} nigga <h1> nigga </h1>"
@app.route("/admin")
def admin():
    return redirect(url_for("home"))
if __name__ == '__main__':
    app.run()
